# ==========================================
# SOVEREIGN - ENVIRONMENT CONFIGURATION
# ==========================================

# Database
# Use your local PostgreSQL connection string. 
# Do not commit real passwords here.
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign

# AI Services
# URL for local Ollama instance (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434

# API Configuration
# Secret key for JWT or session management (replace with a real random string in production)
API_SECRET_KEY=change_me_in_production
PORT=8000
